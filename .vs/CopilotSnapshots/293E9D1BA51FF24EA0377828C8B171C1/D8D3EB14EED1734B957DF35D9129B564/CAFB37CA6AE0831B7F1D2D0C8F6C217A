using Microsoft.Web.WebView2.Core;
using System;
using System.Windows;
using WebBrowserMinimalist.Services;
using Wpf.Ui.Controls;

namespace WebBrowserMinimalist.Views.Windows
{
    public partial class BrowserExtensionsWindow : UiWindow
    {
        private readonly CoreWebView2Profile _profile;
        private readonly BrowserExtensionService _extensionService;

        public BrowserExtensionsWindow(CoreWebView2Profile profile, BrowserExtensionService extensionService)
        {
            InitializeComponent();
            _profile = profile;
            _extensionService = extensionService;
        }

        private async void Import_Click(object sender, RoutedEventArgs e)
        {
            if (string.IsNullOrWhiteSpace(ExtensionSourceTextBox.Text))
            {
                StatusTextBlock.Text = "Introduce una URL o un ID de Chrome Web Store.";
                return;
            }

            string extensionId;
            try
            {
                extensionId = BrowserExtensionService.ParseExtensionId(ExtensionSourceTextBox.Text);
            }
            catch (ArgumentException exception)
            {
                StatusTextBlock.Text = $"URL o ID no válido: {exception.Message}";
                return;
            }

            SetBusy(true);
            StatusTextBlock.Text = $"ID reconocido ({extensionId}). Descargando y validando la extensión…";
            try
            {
                var extension = await _extensionService.InstallFromChromeWebStoreAsync(_profile, extensionId);
                StatusTextBlock.Text = $"Extensión instalada: {extension.Name}.";
                ExtensionSourceTextBox.Clear();
            }
            catch (Exception exception)
            {
                StatusTextBlock.Text = $"No se pudo instalar la extensión: {exception.Message}";
            }
            finally
            {
                SetBusy(false);
            }
        }

        private void Close_Click(object sender, RoutedEventArgs e) => Close();

        private void SetBusy(bool isBusy)
        {
            ExtensionSourceTextBox.IsEnabled = !isBusy;
            ImportButton.IsEnabled = !isBusy;
            CloseButton.IsEnabled = !isBusy;
        }
    }
}
