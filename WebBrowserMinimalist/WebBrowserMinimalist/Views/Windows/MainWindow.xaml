<ui:UiWindow
    x:Class="WebBrowserMinimalist.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:VM="clr-namespace:WebBrowserMinimalist.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:WebBrowserMinimalist.Views.Controls"
    Title="{Binding ApplicationTitle}"
    d:DesignWidth="1100"
    MinWidth="484"
    d:DesignHeight="650"     
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"  StateChanged="Window_StateChanged" Icon="/Views/Windows/icons8-internet-48.png" >
    <Window.DataContext>
        <VM:MainWindowViewModel></VM:MainWindowViewModel>
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="convertToVisibility"></BooleanToVisibilityConverter>
    </Window.Resources>
    <Grid  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Rectangle Visibility="{Binding Visibility,ElementName=menutabs}" Fill="{Binding Background,ElementName=btnclosemenu}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="130" Grid.RowSpan="2" Opacity="0.10">
        </Rectangle>
        <Rectangle
    Fill="Black"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    Grid.RowSpan="2"
    Opacity="0.67">

            <Rectangle.Style>
                <Style TargetType="{x:Type Rectangle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Height" Value="39"/>

                    <Style.Triggers>
                        <!-- Mostrar cuando IsNotIncognit sea false -->
                        <DataTrigger Binding="{Binding IsNotIncognit}" Value="false">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <!-- Altura de 130 cuando el menú está abierto -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=menutabs}"
                             Value="Visible">
                            <Setter Property="Height" Value="130"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
        <ui:TitleBar x:Name="titlebar" Grid.ColumnSpan="2" Grid.RowSpan="2"  Title=""></ui:TitleBar>


        <Grid x:Name="menutabs" ClipToBounds="true" Height="90" Background="{x:Null}" HorizontalAlignment="Left" Visibility="Collapsed">
          
            <Grid Margin="7,7,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <ui:Button Name="btnclosemenu" Icon="ArrowAutofitDown24" WindowChrome.IsHitTestVisibleInChrome="True" IconFilled="True" Padding="5" 
           Cursor="Hand"
           Click="btnclosemenu_Click" BorderThickness="0"  Appearance="Primary" Margin="2"  >

                </ui:Button>
                <UniformGrid x:Name="panelbuttonsprincipales" Visibility="{Binding Visibility,ElementName=lista}" Rows="1" Margin="15 0 0 0" HorizontalAlignment="Left">

                    <Rectangle Width="4" Height="4" Margin="20 0 0 0" RadiusX="10" RadiusY="10" Fill="{Binding Foreground,ElementName=btnDescargasOpen}"></Rectangle>
                    <ui:Button Name="btnDescargasOpen" Cursor="Hand" Icon="ArrowDownload16" Padding="5" BorderThickness="0" Appearance="Transparent"  Margin="2" HorizontalAlignment="Stretch"  Click="btnDescargasOpen_Click" ToolTip="Pagina de Descargas de Edge" WindowChrome.IsHitTestVisibleInChrome="True" >

                    </ui:Button>
                    <ui:Button Name="btnOpenWithIncognit" Cursor="Hand" Icon="Incognito20" Padding="5" Visibility="{Binding IsNotIncognit,Converter={StaticResource convertToVisibility}}" BorderThickness="0"  Appearance="Transparent"  Margin="2"  HorizontalAlignment="Stretch" Click="btnOpenWithIncognit_Click" ToolTip="Abrir en modo incognito" WindowChrome.IsHitTestVisibleInChrome="True" >

                    </ui:Button>
                    <ui:Button Name="btnHistorialOpen" Cursor="Hand" Icon="History16" Padding="5" Appearance="Transparent" Visibility="{Binding IsNotIncognit,Converter={StaticResource convertToVisibility}}" BorderThickness="0"  Margin="2" HorizontalAlignment="Stretch" Click="btnHistorialOpen_Click" ToolTip="Historial de navegación" WindowChrome.IsHitTestVisibleInChrome="True" >

                    </ui:Button>
                    <ui:Button Name="btnCollectionsOpen" Cursor="Hand" Icon="Collections24" Padding="5" Visibility="{Binding IsNotIncognit,Converter={StaticResource convertToVisibility}}" Appearance="Transparent" BorderThickness="0"  Margin="2" HorizontalAlignment="Stretch" Click="btnCollectionsOpen_Click" ToolTip="Colecciones" WindowChrome.IsHitTestVisibleInChrome="True" >

                    </ui:Button>
                </UniformGrid>

                <Grid Grid.Row="1"
      Visibility="{Binding Visibility, ElementName=lista, Mode=OneWay}" Margin="0,9,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pestañas -->
                    <ui:VirtualizingGridView
        x:Name="lista"
        Grid.Column="1"
        Visibility="Collapsed"
        ItemsSource="{Binding Items, Mode=OneWay}"
        SelectionMode="Single"
        SelectedIndex="0"
                        
        SelectionChanged="ListBox_SelectionChanged"
        SizeChanged="lista_SizeChanged"
        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.CanContentScroll="False">

                        <ui:VirtualizingGridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ui:VirtualizingGridView.ItemsPanel>

                        <ui:VirtualizingGridView.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="card"
                      MaxWidth="270"
                                      MinWidth="90"
                      Margin="5,3"                     
                      Tag="{Binding ElementName=btnClose}"
                      MouseEnter="card_MouseEnter"
                      MouseLeave="card_MouseLeave" Cursor="Hand">

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                Header="Cerrar todos menos este"
                                Click="menuItemCerrarMenosEste_Click"/>
                                            <MenuItem
                                Header="Cerrar todos hacia abajo"
                                Click="menuItemCerrarTodosAbajo_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Superficie de la pestaña -->
                                    <Border x:Name="cardSurface"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                                            Margin="-10"
                            Padding="9,5">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Favicon / carga -->
                                            <Grid Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center">

                                                <Image Source="{Binding IMg}"
                                       Width="16"
                                       Height="16"
                                       Stretch="Uniform"/>

                                                <ui:ProgressRing
                                    Visibility="{Binding ProgressVisibility, Mode=OneWay}"
                                    Width="18"
                                    Height="18"
                                    IsVisibleChanged="ProgressRing_IsVisibleChanged"/>
                                            </Grid>

                                            <!-- Título y origen -->
                                            <Grid Grid.Column="1"
                                  Margin="9,0,5,0"
                                  VerticalAlignment="Center">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                    Text="{Binding TitleDoc}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"/>

                                                <TextBlock
                                    Grid.Row="1"
                                    Text="{Binding Source}"
                                    ToolTip="{Binding Source}"
                                    FontSize="11"
                                    Margin="0,1,0,0"
                                    Opacity="0.65"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Acciones -->
                                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                                <ui:SymbolIcon
                                    Symbol="Speaker224"
                                    FontSize="14"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SoundVisibility, Mode=OneWay}"/>

                                                <ui:Button
                                    x:Name="btnClose"
                                    Icon="Dismiss16"
                                    Appearance="Secondary"
                                    Padding="3"
                                    MinWidth="24"
                                    MinHeight="24"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Opacity="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Click="btnClose_Click"
                                    ToolTip="Cerrar pestaña"/>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ui:VirtualizingGridView.ItemTemplate>
                    </ui:VirtualizingGridView>

                    <!-- Separadores laterales -->
                    <Separator
        Grid.Column="0"
        Visibility="{Binding Visibility, ElementName=btnleft}"
        HorizontalAlignment="Right"
        VerticalAlignment="Stretch"
        Margin="0,1,0,2"/>

                    <Separator
        Grid.Column="2"
        Visibility="{Binding Visibility, ElementName=btnleft}"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch"
        Margin="0,1,0,2"/>

                    <!-- Navegación izquierda -->
                    <ui:Button
        x:Name="btnleft"
        Icon="ChevronLeft20"
        Appearance="Transparent"
        BorderThickness="0"
        Padding="4"
        Margin="2,0,3,0"
        Height="42"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Click="btnleft_Click"/>

                    <!-- Navegación derecha -->
                    <ui:Button
        x:Name="btnrigth"
        Grid.Column="2"
        Icon="ChevronRight20"
        Appearance="Transparent"
        BorderThickness="0"
        Padding="5"
            Margin="2,0,3,2"
                        Height="42"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Right"
        Click="btnrigth_Click"
        />

                </Grid>

            </Grid>           
        </Grid>

        <Grid x:Name="Colecciones" Visibility="Collapsed">

            <StackPanel Margin="9,9,0,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">                    
                    <ui:Button Name="btnCloseCollections" VerticalAlignment="Stretch" Icon="ArrowStepBack16" Padding="5" Appearance="Primary"  Click="btnCloseCollections_Click">

                    </ui:Button>
                    <ui:Button x:Name="btnAddCollection" HorizontalAlignment="Left" Icon="CollectionsAdd24" Content="Agregar" Padding="5" Margin="5,0,0,0" Click="btnAddCollection_Click">

                    </ui:Button>
                </StackPanel>
                <controls:CollectionsVMVertical x:Name="collections" Grid.Column="1" Margin="0,5,0,0"></controls:CollectionsVMVertical>

            </StackPanel>
        </Grid>

        <Grid Name="content" Grid.Row="1" Grid.Column="0" Margin="0 2 0 0"></Grid>
        
    </Grid>

</ui:UiWindow>
