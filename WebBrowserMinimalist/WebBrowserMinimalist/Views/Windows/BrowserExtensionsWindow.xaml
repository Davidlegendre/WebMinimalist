<ui:UiWindow x:Class="WebBrowserMinimalist.Views.Windows.BrowserExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		Width="500"
		Height="310"
		MinWidth="420"
		MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="NoResize"
             
        Background="{ui:ThemeResource}">
	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<StackPanel>
			<TextBlock Text="Importar extensión" FontSize="20" FontWeight="SemiBold" />
			<TextBlock Margin="0,6,0,16" TextWrapping="Wrap"
					   Text="Pega una URL de Chrome Web Store o un ID. Solo se instalarán extensiones compatibles con WebView2." />
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox x:Name="ExtensionSourceTextBox" Height="36" VerticalContentAlignment="Center"
						 ToolTip="URL de Chrome Web Store o ID de 32 caracteres" />
				<Button x:Name="ImportButton" Grid.Column="1" Margin="8,0,0,0" Padding="14,5"
						Content="Importar" Click="Import_Click" />
			</Grid>
			<TextBlock x:Name="StatusTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" />
		</StackPanel>
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="CloseButton" Content="Cerrar" Padding="14,6" Click="Close_Click" />
		</StackPanel>
	</Grid>
</ui:UiWindow>
