<ui:UiWindow x:Class="WebBrowserMinimalist.Views.Windows.BrowserExtensionsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Extensiones"
        Width="820"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{ui:ThemeResource}">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="AddPaneColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Extensiones" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Gestiona las extensiones del navegador"
                           FontSize="12" Opacity="0.65" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock x:Name="ExtensionsStatusTextBlock" Grid.Row="1"
                       Text="Cargando extensiones…" FontSize="12" Opacity="0.65"
                       Margin="0,18,0,8" />

            <ListBox x:Name="BrowserExtensionsListBox" Grid.Row="2" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#22808080" BorderThickness="0,0,0,1"
                                Padding="4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Opacity="0.55" />
                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           Stretch="Uniform" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="8,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                               Opacity="0.65" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding ToggleText}" Padding="9,4"
                                            Margin="0,0,6,0" Click="ToggleBrowserExtension_Click" />
                                    <Button Content="Quitar" Padding="9,4"
                                            Click="RemoveBrowserExtension_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Cerrar" Padding="12,7" Margin="0,0,8,0" Click="Close_Click" />
                <Button Padding="12,7" Click="OpenExtensionImporter_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add12" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Añadir" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="AddExtensionPane" Grid.Column="1" Visibility="Collapsed"
                BorderBrush="#33808080" BorderThickness="1,0,0,0" Padding="20,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Añadir extensión" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="30"
                               Height="30" Padding="0" ToolTip="Cerrar"
                               Click="CloseAddPane_Click">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="14" />
                    </ui:Button>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Pega una URL de Chrome Web Store o el ID de la extensión."
                           TextWrapping="Wrap" FontSize="12" Opacity="0.68"
                           Margin="0,8,0,18" />
                <StackPanel Grid.Row="2">
                    <TextBlock Text="URL o ID" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="ExtensionSourceTextBox" Height="38" Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="URL de Chrome Web Store o ID de 32 caracteres" />
                </StackPanel>
                <TextBlock x:Name="ImportStatusTextBlock" Grid.Row="3"
                           TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Margin="0,12,0,0" />
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button x:Name="CancelImportButton" Content="Cancelar" Padding="11,7"
                            Margin="0,0,8,0" Click="CloseAddPane_Click" />
                    <Button x:Name="ImportButton" Content="Instalar" Padding="14,7"
                            Click="Import_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:UiWindow>
