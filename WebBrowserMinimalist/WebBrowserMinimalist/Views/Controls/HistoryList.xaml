<UserControl x:Class="WebBrowserMinimalist.Views.Controls.HistoryList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WebBrowserMinimalist.Views.Controls"
             xmlns:context="clr-namespace:WebBrowserMinimalist.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="370">
    <UserControl.DataContext>
        <context:HistoryListVM></context:HistoryListVM>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:Card Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Historial"></TextBlock>
                    <TextBlock Text="Elimina el historial de la aplicación y WebView2 por periodo. Puedes incluir cookies y datos de sitios."
                               TextWrapping="Wrap"
                               FontSize="12"
                               Opacity="0.7"
                               ></TextBlock>
                    <ComboBox x:Name="HistoryRangeComboBox" SelectedIndex="0"
                              Margin="0,8,0,0" Height="38"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Hoy" />
                        <ComboBoxItem Content="Última hora" />
                        <ComboBoxItem Content="Últimas 24 horas" />
                        <ComboBoxItem Content="Últimos 7 días" />
                        <ComboBoxItem Content="Últimas 4 semanas" />
                        <ComboBoxItem Content="Todo el tiempo" />
                    </ComboBox>
                    <CheckBox x:Name="ClearSiteDataCheckBox"
                              Content="Incluir cookies y datos de sitios (puede cerrar sesiones)"
                              Margin="0,8,0,0" FontSize="12" />
                    <TextBlock Text="Los registros antiguos de la aplicación solo conservan la fecha de la última visita por sitio."
                               TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                               Margin="0,5,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button x:Name="btnClearAll" Click="ClearHistory_Click"
                                   Appearance="Danger" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete12" Margin="0,0,7,0" />
                                <TextBlock Text="Borrar historial" />
                            </StackPanel>
                        </ui:Button>
                        <TextBlock x:Name="ClearStatusTextBlock" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontSize="11" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>
        <ListView Name="listResultSearch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" ItemsSource="{Binding ListaHistorial, Mode=OneWay}" SelectionMode="Single">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1" VerticalAlignment="Top"></UniformGrid>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Name="historyBtn" Height="58" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="historyBtn_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="History16" FontSize="20" Margin="0,0,7,0"></ui:SymbolIcon>
                                <StackPanel Grid.Column="1" >
                                    <TextBlock Text="{Binding title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TitleDocument}"></TextBlock>
                                    <TextBlock Text="{Binding url}" Opacity="0.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding URL}"></TextBlock>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>            
        </ListView>
    </Grid>
</UserControl>
